# Copy to .env (run.sh does this automatically). All values optional.
INITIAL_BALANCE=100000
DB_PATH=intraday_sathi.db
MODEL_DIR=models
DAILY_LOSS_LIMIT=2000
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=3
MIN_CONFIDENCE=0.60
RETRAIN_MIN_TRADES=30
TRAIN_SYMBOLS=15
CANDLE_TTL_SECONDS=60
AUTO_INTERVAL_SECONDS=60
# Set false only to test outside NSE hours (09:15-15:30 IST, Mon-Fri)
ENFORCE_MARKET_HOURS=true
# Try to download the full NSE equity list at startup
LOAD_FULL_UNIVERSE=true
